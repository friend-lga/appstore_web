- @login_active = true
- @should_show_prototype_info = true

- content_for :body do
  div.my-block__center.my-5.p-3
    ul.nav.nav-pills.nav-justified.mb-3 id="ex1" role="tablist"
      li.nav-item role="presentation"
        = link_to("Вход", new_user_session_path, class: "nav-link active", "aria-selected" => "true")
      li.nav-item
        = link_to("Регистрация", new_user_registration_path, class: "nav-link", "aria-selected" => "false")

    - if flash[:alert].present?
      div.alert.alert-danger.d-flex.align-items-center role="alert"
        = flash[:alert]
    - if resource.errors.messages.present?
      div.alert.alert-danger.d-flex.align-items-center role="alert"
        - resource.errors.messages.each do |field, messages|
          - messages.each do |message|
            = "#{field}: #{message}"
            br

    .text-center.mb-3
      p
        | Войти с помощью:
      button.btn.btn-link.btn-floating.mx-1[type="button"]
        i.bi.bi-facebook
      button.btn.btn-link.btn-floating.mx-1[type="button"]
        i.bi.bi-google
      button.btn.btn-link.btn-floating.mx-1[type="button"]
        i.bi.bi-twitter
      button.btn.btn-link.btn-floating.mx-1[type="button"]
        i.bi.bi-github
      button.btn.btn-link.btn-floating.mx-1[type="button"]
        i.bi.bi-apple
      p
        | или:

    = form_with(model: resource,
              as: resource_name,
              url: session_path(resource_name),
              html: {novalidate: 'novalidate'}) do |f|
      div.form-floating.mb-2
        = f.email_field("email", value: "user@example.com", class: "form-control", placeholder: "Электронная почта")
        label.form-label for="user_email"
          | Электронная почта
      div.form-floating.mb-2
        = f.password_field("password", value: "1234", class: "form-control", placeholder: "Пароль")
        label.form-label for="user_password"
          | Пароль
      div.row.mb-4
        div.col-md-6.d-flex.justify-content-center
          div.form-check.mb-2.mb-md-0
            = f.check_box("remember_me", class: "form-check-input", checked: true)
            label.form-check-label[for="user_remember_me"]
              | Запомнить меня
        div.col-md-6.d-flex.justify-content-center
          = link_to("Забыли пароль?", "#")
      = f.submit("Войти", class: "btn btn-lg btn-primary w-100")

- content_for :prototype_info do
  | Экран входа обычных пользователей. Они могут войти либо через подключенные социальные сети, или же стандартно, по почте и паролю.
  br
  br
  | Возможность входа через социальные сети и восстановление пароля в прототипе не предусмотрены.
