= form_with(model: @app) do |form|
  - if @app.errors.any?
    div style="color: red"
      h2 = "#{pluralize(@app.errors.count, 'error')} prohibited this app from being saved:"
      ul
        - @app.errors.each do |error|
          li = error.full_message

  div
    = form.label :id, style: "display: block"
    = form.number_field :id

  div
    = form.label :title, style: "display: block"
    = form.text_field :title

  div
    = form.label :description, style: "display: block"
    = form.text_field :description

  div
    = form.label :version, style: "display: block"
    = form.number_field :version

  div
    = form.label :icon, style: "display: block"
    = form.file_field :icon

  div
    = form.label :package, style: "display: block"
    = form.file_field :package

  div
    = form.label :user_id, style: "display: block"
    = form.text_field :user_id

  div
    = form.label :category, style: "display: block"
    = form.text_field :category

  div
    = form.label :tags, style: "display: block"
    = form.text_field :tags

  div
    = form.label :created_at, style: "display: block"
    = form.date_field :created_at

  div
    = form.label :updated_at, style: "display: block"
    = form.date_field :updated_at

  div
    = form.submit
